        "printed_contact_sleeve (30)",
        "printed_contact_sleeve (4)",
        "printed_contact_sleeve (5)",
        "printed_contact_sleeve (6)",
        "printed_contact_sleeve (7)",
        "printed_contact_sleeve (8)",
        "printed_contact_sleeve (9)",
        "printed_drive_sleeve",
        "printed_drive_sleeve (2)",
        "printed_drive_sleeve (3)",
        "printed_drive_sleeve (4)",
        "printed_drive_sleeve (5)",
        "printed_drive_sleeve (6)"
      ],
      "loose_parts": {
        "printed_contact_sleeve": 30,
        "printed_drive_sleeve": 6
      }
    },
    {
      "key": "step_08",
      "title": "Start cam B",
      "action": "Slide the B outer cam onto the two shaft screws with its narrow eccentric journal facing up.",
      "add": [
        "shaft_cam_b_outer"
      ],
      "loose_parts": {
        "shaft_cam_b_outer": 1
      }
    },
    {
      "key": "step_09",
      "title": "Prepare disc B",
      "action": "On the bench, seat one 6704 between the B screw half and the B nut half. Match the three clamp holes before closing the halves.",
      "add": [
        "rotor_b",
        "hardware_6704_disc_b",
        "rotor_b_cap"
      ],
      "loose_parts": {
        "H2": 1,
        "rotor_b": 1,
        "rotor_b_cap": 1
      }
    },
    {
      "key": "step_10",
      "title": "Clamp disc B",
      "action": "Fit three M3 nuts and three M3 \u00d7 6 countersunk screws. Seat the heads flush. Orient the closed disc with the screw heads facing down for installation.",
      "add": [
        "hardware_disc_b_M3x6_1",
        "hardware_disc_b_M3x6_2",
        "hardware_disc_b_M3x6_3",
        "hardware_disc_b_nut_1",
        "hardware_disc_b_nut_2",
        "hardware_disc_b_nut_3"
      ],
      "loose_parts": {
        "H5": 3,
        "H6": 3
      }
    },
    {
      "key": "step_11",
      "title": "Install B and oppose the cams",
      "action": "Lower the closed B disc over all six guide sleeves and onto the B journal. Point its indexed clamp screw toward the wide guide gap. Add B inner cam journal-down, then A inner cam journal-up. Their eccentric offsets face opposite ways.",
      "add": [
        "shaft_cam_b_inner",
        "shaft_cam_a_inner"
      ],
      "loose_parts": {
        "shaft_cam_a_inner": 1,
        "shaft_cam_b_inner": 1
      }
    },
    {
      "key": "step_12",
      "title": "Prepare disc A",
      "action": "Seat a 6704 bearing between the two A disc halves. Orient the A screw half upward and align all three clamp holes.",
      "add": [
        "rotor_a_cap",
        "hardware_6704_disc_a",
        "rotor_a"
      ],
      "loose_parts": {
        "H2": 1,
        "rotor_a": 1,
        "rotor_a_cap": 1
      }
    },
    {
      "key": "step_13",
      "title": "Clamp disc A",
      "action": "Fit three M3 nuts and three M3 \u00d7 6 countersunk screws. Seat the heads flush with the upward-facing screw half.",
      "add": [
        "hardware_disc_a_nut_1",
        "hardware_disc_a_nut_2",
        "hardware_disc_a_nut_3",
        "hardware_disc_a_M3x6_1",
        "hardware_disc_a_M3x6_2",
        "hardware_disc_a_M3x6_3"
      ],
      "loose_parts": {
        "H5": 3,
        "H6": 3
      }
    },
    {
      "key": "step_14",
      "title": "Install A and close its cam",
