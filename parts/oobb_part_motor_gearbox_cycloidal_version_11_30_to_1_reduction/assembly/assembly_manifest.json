    {
      "key": "step_03",
      "title": "Seat the first two bearings",
      "action": "Lower the 6810 over the black journal and the centred 6704 over the yellow journal. Seat both flat on their shoulders.",
      "add": [
        "hardware_6810_top",
        "hardware_6704_top"
      ],
      "loose_parts": {
        "H1": 1,
        "H2": 1
      }
    },
    {
      "key": "step_04",
      "title": "Place the empty nut trays",
      "action": "Lower the square socket-side plate. Slide the large black eight-pocket tray and small turquoise four-pocket tray over the standing screws, with both sets of pockets open upward.",
      "add": [
        "output_cap_plate",
        "carrier_top_nut_tray",
        "shaft_mount_upper_nut_tray"
      ],
      "loose_parts": {
        "carrier_top_nut_tray": 1,
        "output_cap_plate": 1,
        "shaft_mount_upper_nut_tray": 1
      }
    },
    {
      "key": "step_05",
      "title": "Load the twelve mounting nuts",
      "action": "Drop eight M3 nuts into the black tray and four into the turquoise tray. Seat the flats in their pockets while the screw heads remain supported.",
      "add": [
        "hardware_carrier_top_mount_nut_1",
        "hardware_carrier_top_mount_nut_2",
        "hardware_carrier_top_mount_nut_3",
        "hardware_carrier_top_mount_nut_4",
        "hardware_carrier_top_mount_nut_5",
        "hardware_carrier_top_mount_nut_6",
        "hardware_carrier_top_mount_nut_7",
        "hardware_carrier_top_mount_nut_8",
        "hardware_shaft_mount_nut_upper_1",
        "hardware_shaft_mount_nut_upper_2",
        "hardware_shaft_mount_nut_upper_3",
        "hardware_shaft_mount_nut_upper_4"
      ],
      "loose_parts": {
        "H6": 12
      }
    },
    {
      "key": "step_06",
      "title": "Close both trays",
      "action": "Lower the socket-end carrier core over the eight outer nuts and the small shaft nut carrier over the four inner nuts. Both covers should settle flat.",
      "add": [
        "carrier_top",
        "shaft_mount_upper"
      ],
      "loose_parts": {
        "carrier_top": 1,
        "shaft_mount_upper": 1
      }
    },
    {
      "key": "step_07",
      "title": "Add the sleeves",
      "action": "Slide 30 yellow contact sleeves onto the ring screws and six yellow guide sleeves onto the inner screws. Seat the six guides in the carrier sockets.",
      "add": [
        "printed_contact_sleeve",
        "printed_contact_sleeve (10)",
        "printed_contact_sleeve (11)",
        "printed_contact_sleeve (12)",
        "printed_contact_sleeve (13)",
