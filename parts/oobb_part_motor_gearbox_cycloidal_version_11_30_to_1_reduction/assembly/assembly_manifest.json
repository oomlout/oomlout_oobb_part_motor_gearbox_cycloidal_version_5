  "steps": [
    {
      "key": "step_01",
      "title": "Set down the socket end",
      "action": "Place the socket-side cylinder, black carrier cap and yellow two-socket journal flange-down on a support with access underneath. The native model calls this end \u201cupper\u201d.",
