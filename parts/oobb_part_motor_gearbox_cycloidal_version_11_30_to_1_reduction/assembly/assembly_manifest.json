        "printed_contact_sleeve (24)",
        "printed_contact_sleeve (25)",
        "printed_contact_sleeve (26)",
        "printed_contact_sleeve (27)",
        "printed_contact_sleeve (28)",
        "printed_contact_sleeve (29)",
