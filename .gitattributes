# Auto detect text files and perform LF normalization
* text=auto
# Sealed artefacts and the acceptance policy have byte-level verification hashes.
parts/** -text
navigation_oobb/** -text
releases/** -text
gearbox_native/acceptance.py -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
